# Copy to .env on the staging host and replace every placeholder with values
# from its secret manager. Never commit the populated .env file.
POSTGRES_DB=snapkey_vision
POSTGRES_USER=snapkey
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
SNAPKEY_CRM_INTEGRATION_KEY=REPLACE_WITH_RANDOM_SERVER_SIDE_KEY
# Integration requests must match an explicitly approved tenant/shop allow-list.
# Example shape only: [{"tenant_id":"tenant-code","shop_ids":["shop-id"]}]
SNAPKEY_CRM_INTEGRATION_ALLOWED_SCOPES=[]
SNAPKEY_EDGE_API_TOKEN=REPLACE_WITH_RANDOM_EDGE_API_TOKEN
SNAPKEY_EDGE_ACTIVATION_CODE=REPLACE_WITH_RANDOM_ACTIVATION_SECRET
SNAPKEY_LICENSE_PRIVATE_KEY=REPLACE_WITH_LICENSE_PRIVATE_KEY
SNAPKEY_LICENSE_PUBLIC_KEY=REPLACE_WITH_LICENSE_PUBLIC_KEY
SNAPKEY_CRM_API_BASE_URL=https://apis.snapkey.in
# Optional administrative roster/break-catalogue credentials; employee attendance uses Face Login.
SNAPKEY_CRM_API_TOKEN=
# Optional tenantCode-to-service-token JSON map; keep real values in the server secret store.
# Example shape only: {"tenant-code":"<tenant-scoped-token>"}
SNAPKEY_CRM_API_TOKENS_BY_TENANT_JSON={}
SNAPKEY_CRM_FACE_LOGIN_URL=https://apis.snapkey.in/api/Auth/loginUsingFaceTenant
SNAPKEY_CRM_AUTO_LOGIN_ENABLED=0
SNAPKEY_CRM_AUTO_LOGOUT_ENABLED=0
# Leave blank to use the employee/shop attendance policy timezone.
SNAPKEY_CRM_ATTENDANCE_TIMEZONE=
# Opaque tokens without JWT exp are not cached by default; configure only from CRM evidence.
SNAPKEY_CRM_TOKEN_FALLBACK_TTL_SECONDS=0
CAMERA_EYE_V2_CRM_AUTO_LOGOUT_ENABLED=false
# Generate a Fernet key for staging with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store this in a secret manager and back it up securely; losing it invalidates cached CRM tokens.
# Required for all employee attendance actions: Fernet encryption key for the PostgreSQL token vault.
CAMERA_EYE_TOKEN_ENCRYPTION_KEY=
SNAPKEY_PUBLIC_BASE_URL=https://camera.example.invalid
SNAPKEY_LIVEKIT_URL=wss://livekit.example.invalid
SNAPKEY_LIVEKIT_API_KEY=
SNAPKEY_LIVEKIT_API_SECRET=
SNAPKEY_SMTP_HOST=
SNAPKEY_SMTP_PORT=587
SNAPKEY_SMTP_USER=
SNAPKEY_SMTP_PASSWORD=
SNAPKEY_SMTP_FROM=
SNAPKEY_SMTP_STARTTLS=1
SNAPKEY_WHATSAPP_PHONE_NUMBER_ID=
SNAPKEY_WHATSAPP_ACCESS_TOKEN=
SNAPKEY_WHATSAPP_API_VERSION=v23.0
